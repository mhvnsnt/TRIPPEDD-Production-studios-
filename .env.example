# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this studio is hosted.
APP_URL="MY_APP_URL"

# Public Google Drive option: if the pilot folder is shared as "Anyone with the link",
# a Google API key can anonymously list/download public Drive files. No OAuth consent is needed.
# The Google Drive API must be enabled for this key.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Optional OAuth fallback for private Drive folders. PKCE is used; no client secret is required.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_REDIRECT_URI="MY_APP_URL/api/auth/google/callback"

# Optional: override the pilot source folder.
TRIPPEDD_DRIVE_FOLDER_ID="1e55zooUU98r9MXyRzcR0qgNq1EqGiqVI"
