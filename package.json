{
  "name": "trippedd-production-studios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node fix_mic.cjs && tsx server.ts",
    "build": "node fix_mic.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node fix_mic.cjs && node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node fix_mic.cjs && tsc --noEmit",
    "studio:audit": "tsx scripts/audit-studio-toolchain.ts",
    "studio:test:evidence-cache": "tsx scripts/test-evidence-cache.ts",
    "pilot:build": "tsx scripts/build-ep01.ts",
    "pilot:build:public": "tsx scripts/run-public-pilot.ts",
    "pilot:qc": "tsx scripts/qc-ep01.ts",
    "pilot:greenlight": "tsx scripts/greenlight-ep01.ts",
    "pilot:master": "tsx scripts/build-ep01-master.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0"
  }
}
