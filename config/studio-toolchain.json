{
  "schemaVersion": 2,
  "name": "TRIPPEDD Production Studios Open-Source Production Stack",
  "principle": "Every production capability must resolve to a real executable, library, service, project format, generated artifact, or explicit human gate. No fake AVAILABLE state.",
  "required": ["ffmpeg", "ffprobe", "opencv", "pyscenedetect", "whisper", "tesseract", "otio"],
  "optional": ["blender", "openimageio", "kdenlive", "mlt", "natron", "opencolorio", "openassetio", "opencue", "demucs", "flamenco"],
  "interchange": { "editorial": "OpenTimelineIO", "assets": "OpenAssetIO", "color": "OpenColorIO", "media": "FFmpeg/FFprobe", "images": "OpenImageIO" },
  "backends": {
    "deterministicMedia": "ffmpeg",
    "analysis": ["ffprobe", "opencv", "pyscenedetect", "whisper", "tesseract", "openimageio"],
    "procedural3D": "blender",
    "editorial": "kdenlive",
    "editorialRender": "mlt",
    "compositing": "natron",
    "colorManagement": "opencolorio",
    "assetInterchange": "openassetio",
    "distributedRendering": ["flamenco", "opencue"]
  },
  "episodeCuts": {
    "autonomous": "AUTONOMOUS",
    "storyRunner": "SHOWRUNNER",
    "sharedEvidencePolicy": "Both cuts consume the same physical-source evidence model; editorial interpretation remains separate."
  },
  "policy": {
    "optionalToolsMayBeAbsent": true,
    "absenceMustBeExplicit": true,
    "archivedProjectsMustNotBeBlindlyProvisioned": true,
    "humanEditorialLockRequiredForFinalMaster": true,
    "generatedMaterialMustCarryProvenance": true,
    "physicalSourceTimelineIsAuthoritativeForPhysicalEvents": true
  }
}