#!/usr/bin/env python3
import argparse, json, os
from pathlib import Path

def main():
    p = argparse.ArgumentParser()
    p.add_argument('input')
    p.add_argument('--model', default='tiny')
    p.add_argument('--output_dir', required=True)
    p.add_argument('--output_format', default='json')
    args, _ = p.parse_known_args()
    try:
        from faster_whisper import WhisperModel
    except Exception as exc:
        raise SystemExit(f'faster-whisper unavailable: {exc}')
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    device = os.environ.get('TRIPPEDD_WHISPER_DEVICE', 'cpu')
    compute_type = os.environ.get('TRIPPEDD_WHISPER_COMPUTE_TYPE', 'int8')
    model = WhisperModel(args.model, device=device, compute_type=compute_type)
    segments, info = model.transcribe(args.input, vad_filter=True)
    rows = []
    for segment in segments:
        rows.append({'start': float(segment.start), 'end': float(segment.end), 'text': segment.text})
    payload = {
        'text': ' '.join(item['text'].strip() for item in rows).strip(),
        'segments': rows,
        'language': getattr(info, 'language', None),
        'language_probability': getattr(info, 'language_probability', None),
    }
    out = output_dir / (Path(args.input).stem + '.json')
    out.write_text(json.dumps(payload, ensure_ascii=False), encoding='utf-8')
    print(json.dumps({'segments': len(rows), 'output': str(out)}))

if __name__ == '__main__':
    main()
