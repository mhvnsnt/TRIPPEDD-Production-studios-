# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# The studio can also reuse this key for anonymous public Drive access when the Drive API is enabled for the same Google Cloud project.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this studio is hosted.
APP_URL="MY_APP_URL"

# Optional dedicated Google API key for an "Anyone with the link" Drive folder.
# If omitted, GEMINI_API_KEY is used as the public Drive API key.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Optional OAuth fallback for private Drive folders. PKCE is used; no client secret is required.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_REDIRECT_URI="MY_APP_URL/api/auth/google/callback"

# Optional: override the pilot source folder.
TRIPPEDD_DRIVE_FOLDER_ID="1e55zooUU98r9MXyRzcR0qgNq1EqGiqVI"

# Physical Rocket live-session bridge. No mock/local fallback exists.
# Leave unset until the real running production runtime is reachable.
ROCKET_LIVE_SESSION_URL=""
# Optional shared-secret header for the physical runtime.
ROCKET_LIVE_SESSION_SECRET=""
# Endpoint paths are configurable because the existing runtime is authoritative.
# Defaults are /health, /capabilities, /state and POST /command.
ROCKET_LIVE_SESSION_HEALTH_PATH="health"
ROCKET_LIVE_SESSION_CAPABILITIES_PATH="capabilities"
ROCKET_LIVE_SESSION_STATE_PATH="state"
ROCKET_LIVE_SESSION_COMMAND_PATH="command"
