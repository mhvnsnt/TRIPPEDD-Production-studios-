node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.trippedd_venv
.trippedd_tools
.trippedd_toolchain.json
# ASR model weights, fetched at runtime and verified by ModelArtifactManager.
# 1.9 GB of binaries that the toolchain re-downloads on demand — never repo content.
.trippedd_models
dist
.next/
footage/

# Contact sheets are derived from the footage; regenerate, don't commit.
public/contact/

# The source catalog is the creator's ground truth, built locally per machine.
.trippedd_catalog.json

# Analysed evidence — rebuilt from the footage, not repo content.
.trippedd_tools/

# OWNER LAW #6 (2026-09-12): NEVER HOLD AN ASSET HOSTAGE.
# These four lines were a production stoppage. MARS_LOD2.glb is 2 MB. It was
# excluded from the checkout for "provenance" reasons, so every other agent and
# every CI runner saw an empty directory, could not render the real mesh, and
# spent days asking for a file that was sitting on one container's disk. An
# agent should never have to beg for bytes. Committed, all of them.
!assets/source_models/*.glb
!assets/source_models/*.fbx
!assets/source_models/*.obj
public/model_views/

renders/
vendor/blender
!assets/rigs/*.blend
!assets/rigs/*.glb
.trippedd_libs/
.trippedd_models/
# Blender editor backups only -- regenerated on every save, never evidence.
# NOTE: .gitignore has NO trailing comments. Putting this note on the pattern
# line itself turned it into a literal pattern with a '#' in it, the rule
# stopped matching, and a 33 MB .blend1 backup went to main.
assets/rigs/*.blend1
vendor/*
vendor/rhubarb/

# Python bytecode from the Blender tool scripts.
__pycache__/
*.pyc
.trippedd/
public/production/*.mp4
public/production/*.json
public/production/*-segments/

# Rendered evidence is regenerable and stays out of git...
#   ...EXCEPT the downscaled published copies under docs/evidence/, which are
#   how every other agent and every CI runner actually SEES the work. A frame
#   that exists only on one container is not evidence anyone can check.
!docs/evidence/
!docs/evidence/**

# The FACS basis is 4.6 MB and every agent and CI runner needs it to build a
# face. Cloning ICT-FaceKit to get it is 444 MB. MIT licensed, attribution and
# hashes in vendor/ict/ict_facs.json. PUBLISHED OR IT DOES NOT EXIST.
# (`vendor/*` above, not `vendor/`: git cannot re-include anything inside an
#  excluded DIRECTORY, so the directory itself must stay visible.)
!vendor/ict/

# MPFB2 (MakeHuman for Blender) is vendored as a full upstream clone for
# reference anatomy and its proven eye/lid system. 105 MB, AGPL, re-clonable.
vendor/opensource/

# DERIVED, NOT WITHHELD (OWNER LAW #6). MARS_FACE_HIRES.blend is rebuilt in one
# command from two files that ARE committed -- assets/rigs/MARS_FACE.blend and
# assets/source_models/MARS_source.glb:
#     vendor/blender/blender -b -P tools/models/upgrade_render_mesh.py -- --hires SOURCE
# At SOURCE resolution it is 282.6 MB even compressed, past GitHub's 100 MB hard
# limit, and no input is hidden by leaving it out. The bind manifest
# (renders/_rig_measure/hires_bind.json, published to docs/evidence/quality/)
# records every gate number so the result is checkable without the scene.
assets/rigs/MARS_FACE_HIRES.blend
assets/rigs/MARS_FACE_HIRES.blend1
