<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ebutts="urn:ebu:tt:style" xmlns:itts="http://www.w3.org/ns/ttml/profile/imsc1#styling" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang=""><head><layout><region xml:id="r0" tts:color="#ffffff" tts:displayAlign="after" tts:extent="95% 91.3043%" itts:fillLineGap="true" tts:fontFamily="sansSerif" tts:fontSize="75%" tts:lineHeight="125%" ebutts:linePadding="0.5c" tts:origin="2.5% 4.34783%" tts:textAlign="center" tts:writingMode="lrtb" /></layout></head><body><div><p region="r0" begin="00:00:00.000" end="00:00:02.500"><span tts:backgroundColor="#000000cc">The city never sleeps,</span></p><p region="r0" begin="00:00:02.500" end="00:00:05.000"><span tts:backgroundColor="#000000cc">but tonight it holds its breath.</span></p><p region="r0" begin="00:00:05.000" end="00:00:08.000"><span tts:backgroundColor="#000000cc" tts:fontStyle="italic"><span>Thunder</span></span><span tts:backgroundColor="#000000cc"> rolls over the river —</span></p></div></body></tt>