{
  "$schema": "trippedd.mars-blink-vector-field/v2",
  "canonical": {
    "source": "MARS_source.glb",
    "mutationAllowed": false
  },
  "problem": {
    "statement": "A single closure-axis projection can move the lid margin away from the authored eyelid curve when additional travel overshoots the local curve.",
    "latestMeasuredLeftGapMm": 1.38,
    "latestMeasuredRightGapMm": 0.99,
    "previousOvershootLeftGapMm": 4.13,
    "previousMeasuredLeftGapMm": 3.37,
    "latestOpenLeftGapMm": 6.92,
    "latestOpenRightGapMm": 6.09
  },
  "solution": {
    "model": "per_vertex_curve_targeted_vector_field",
    "components": ["curve_normal_closure", "curve_tangent_follow", "surface_normal_constraint"],
    "single_global_closure_axisForbidden": true,
    "nearestAuthoredCurvePointRequired": true,
    "correctiveShapeKeyPreferred": true
  },
  "measurement": {
    "travelDenominator": "per_margin_vertex_open_gap_to_authored_curve_target",
    "lineToLineApertureMayNotBeUsedAsTravelDenominator": true,
    "report": ["open_gap_mm", "closed_gap_mm", "gap_reduction_mm", "margin_travel_mm", "local_required_travel_mm", "travel_ratio", "curve_landing_mm"],
    "monotonicClosureRequired": true,
    "directionRegressionRequired": true
  },
  "eyeball": {
    "geometryPresent": true,
    "source": "assets/donor/gnm_eyes/eye_{L,R}.npz",
    "assemblyTool": "tools/character/ict_eye_assembly.py",
    "upstream": "ICT-VGL/ICT-FaceKit",
    "license": "MIT",
    "globeDiameterMm": 24.0,
    "globeVerticesPerEye": 1926,
    "clearanceStatus": "MEASURABLE",
    "clearanceGateRequired": true,
    "mustNotInventGeometryForGate": true,
    "historicalFailure": "similarity-fit placement put the eye assembly far behind the authored aperture; rigid re-seating is allowed, globe geometry mutation is not"
  },
  "promotion": {
    "unknownNeverPass": true,
    "actualPixelsRequired": true,
    "oldBlinkKeysRemainNegativeControls": true,
    "realEyeballClearanceRequired": true
  }
}
