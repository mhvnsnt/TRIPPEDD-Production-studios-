{
  "$schema":"trippedd.mars-oss-stack/v2",
  "canonical_source":"assets/source_models/MARS_source.glb",
  "authority":{
    "face_linework":"assets/rigs/MARS_linework_authority.json",
    "render_surface":"assets/source_models/MARS_source.glb",
    "contact_law":"docs/character/COLLISION-AND-CONTACT-LAW.md",
    "expression_contract":"tools/character/mars_expression_contract.json",
    "face_completion":"tools/character/mars_face_completion_contract.json",
    "ear_rig":"tools/character/mars_ear_rig_spec.json",
    "hair_completion":"tools/character/mars_hair_completion_spec.json",
    "visual_evidence":"tools/character/mars_visual_evidence_contract.json"
  },
  "full_repo_umbrella":{
    "root":"third_party/oss",
    "policy":"whole_repository_pinned_submodule",
    "floating_refs_forbidden":true,
    "bootstrap":"git submodule update --init --recursive"
  },
  "components":[
    {"name":"Blender","repository":"https://github.com/blender/blender","pinned_commit":"954a62b3420b287de83ca92ab80b3ddaf5208aa0","license":"GPL-2.0-or-later","priority":"P0","path":"third_party/oss/blender","lanes":["dcc","render","geometry","animation","physics","fluids","xpbd"]},
    {"name":"Blender Addons","repository":"https://github.com/blender/blender-addons","pinned_commit":"b42d68627734cb18af0e6f41537063984313a284","license":"GPL-2.0-or-later","priority":"P0","path":"third_party/oss/blender-addons","lanes":["rigify","mesh_tissue","modeling","animation","topology"]},
    {"name":"facial-animation","repository":"https://github.com/mdj128/facial-animation","pinned_commit":"5bd659df62fc4877be3183964cea1268d86ecf93","license":"MIT","priority":"P0","path":"third_party/oss/facial-animation","lanes":["face","expressions","lip_sync","qa","agent_workbench"],"adapter":"tools/character/run_face_rig_upstream.py"},
    {"name":"Open Mocap Blender","repository":"https://github.com/Larenju-Rai/open-mocap-blender","pinned_commit":"1ec7457dad228661cbd8a1d98163e8288d3f7db5","license":"MIT","priority":"P0","path":"third_party/oss/open-mocap-blender","lanes":["body_capture","hand_capture","retarget"],"adapter":"tools/character/run_open_mocap_upstream.py"},
    {"name":"BlenRig","repository":"https://github.com/jpbouza/BlenRig","pinned_commit":"ecad8139514069e67687028fdf619488cb8117d2","license":"UPSTREAM_LICENSE_REQUIRED","priority":"P0","path":"third_party/oss/BlenRig","lanes":["auto_rig","skinning","deform_cage","facial_rig"]},
    {"name":"FacialAutoRigger","repository":"https://github.com/joeedh/FacialAutoRigger","pinned_commit":"94ddf2a8967012724ae0c155fd6390a7ad81093c","license":"MIT","priority":"P1","path":"third_party/oss/FacialAutoRigger","lanes":["facial_rig_experiment","shape_keys"]},
    {"name":"ARKit-Creator-Blender-Addon","repository":"https://github.com/tsikerdekis/ARKit-Creator-Blender-Addon","pinned_commit":"858a049993d9b6bf358264e1df1a40179bc83b50","license":"MIT","priority":"P1","path":"third_party/oss/ARKit-Creator-Blender-Addon","lanes":["expressions","arkit","shape_keys"]},
    {"name":"BlendCap","repository":"https://github.com/Arcomade/BlendCap","pinned_commit":"e3238699507c00e34b6c948931c4742915b8dc42","license":"GPL-3.0-or-later-plus-third-party","priority":"P1","path":"third_party/oss/BlendCap","lanes":["performance_capture","face_capture","hands","body","retarget"],"adoption":"source_reference_until_dependency_licenses_cleared"},
    {"name":"mcp-blender","repository":"https://github.com/RFingAdam/mcp-blender","pinned_commit":"4ae5645aa1f0c8f099c2a90969fdd392c0cc9851","license":"UPSTREAM_LICENSE_REQUIRED","priority":"P0","path":"third_party/oss/mcp-blender","lanes":["agent_control","inspection","rigging","animation","physics"]},
    {"name":"Mesh Analysis Overlay","repository":"https://github.com/dshot92/mesh-analysis-overlay","pinned_commit":"e80bdef89a0bc78f8c4ad452ddab8b31b1a410d4","license":"GPL-3.0-or-later","priority":"P0","path":"third_party/oss/mesh-analysis-overlay","lanes":["topology_qa","mesh_visual_inspection","normal_qa"],"role":"observer_only"},
    {"name":"Blender 5.2 XPBD","repository":"https://www.blender.org/","license":"GPL-2.0-or-later","priority":"P0","lanes":["hair","cloth","collision"],"role":"runtime capability provided by pinned Blender source; native Geometry Nodes/XPBD preferred"},
    {"name":"ARKit Pose Recorder for Blender","repository":"https://github.com/harlynkingm/ARKit-Pose-Recorder-for-Blender","license":"Apache-2.0","priority":"P0","lanes":["expressions","bone_to_shape","pose_review"],"role":"repeatable pose/reference UI; never anatomical authority"},
    {"name":"ShapeUp","repository":"https://github.com/dan283/ShapeUp","license":"MIT","priority":"P1","lanes":["facs","shape_keys","inbetweens"]},
    {"name":"HairRigAddon","repository":"https://github.com/latidoremi/HairRigAddon","license":"GPL-3.0","priority":"P1","lanes":["hair_rig_experiment"]}
  ],
  "execution_lanes":{
    "character_construction":{"tools":["Blender","Blender Addons","BlenRig","facial-animation","FacialAutoRigger","ARKit-Creator-Blender-Addon"],"source_immutable":true},
    "face_rig":{"adapter":"tools/character/run_face_rig_upstream.py","gate":"tools/character/expression_gate.py","authority":"assets/rigs/MARS_linework_authority.json"},
    "visual_inspection":{"tools":["mcp-blender","Mesh Analysis Overlay"],"contract":"tools/character/mars_visual_evidence_contract.json","gate":"tools/character/mars_visual_evidence_gate.py","required":"actual_committed_pixels_and_overlay"},
    "performance_capture":{"tools":["Open Mocap Blender","BlendCap","ARKit Pose Recorder for Blender"],"target":"MARS","source_immutable":true},
    "ears":{"spec":"tools/character/mars_ear_rig_spec.json","target":"measured_source_geometry","source_immutable":true},
    "hair_collision":{"simulation":"Blender 5.2 XPBD","spec":"tools/character/mars_hair_completion_spec.json","measurement_gate":"tools/character/contact_gate.py","self_collision":"NOT_ATTEMPTED"},
    "fluids":{"engine":"Blender Mantaflow","source":"third_party/oss/blender","targets":["water","rain","tears","spray","smoke"],"external_solver_policy":"only add separately licensed reproducible full projects"},
    "mesh_quality":{"tools":["Mesh Analysis Overlay","Blender Addons"],"gate":"tools/character/mesh_quality_gate.py","source_immutable":true,"operation_policy":"local_quad_preserving_derivatives_only"},
    "pose_review":{"tool":"ARKit Pose Recorder for Blender","authority":"owner_linework_and_measured_geometry","output":"review_only"},
    "agent_blender":{"tool":"mcp-blender","role":"agent_operator_and_inspector","authority":"repo_gates_and_actual_pixels"}
  },
  "protected_lanes":["eyes_blink","nostrils_nose","mouth_oral"],
  "rules":[
    "Full upstream repositories are pinned as whole submodules; do not cherry-pick a convenience file when the complete tool is useful.",
    "Third-party output is derivative, never anatomical authority.",
    "MARS source render surface is immutable by integration tools.",
    "Owner-drawn facial linework overrides generic landmark systems.",
    "Eyes, nostrils and mouth are locked against unmeasured changes once their current proof passes.",
    "A higher triangle count is not sufficient; edge-size distribution, UVs, normals, materials, silhouette and visual detail must be measured.",
    "Global voxel remesh, global triangulation and destructive decimation are forbidden on the canonical render surface.",
    "Every adopted run records tool version, source hash, output hash, command and evidence.",
    "Every motion claim requires a multi-state visual sequence and numerical measurements.",
    "Every visual claim requires actual pixels and an inspectable evidence artifact; backend-only assertions are insufficient.",
    "License and dependency review is required before redistributing any upstream project's bundled third-party models or assets.",
    "UNKNOWN is never PASS."
  ]
}
