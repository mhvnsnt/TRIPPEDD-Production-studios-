# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# The studio can also reuse this key for anonymous public Drive access when the Drive API is enabled for the same Google Cloud project.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this studio is hosted.
APP_URL="MY_APP_URL"

# Optional dedicated Google API key for an "Anyone with the link" Drive folder.
# If omitted, GEMINI_API_KEY is used as the public Drive API key.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Optional OAuth fallback for private Drive folders. PKCE is used; no client secret is required.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_REDIRECT_URI="MY_APP_URL/api/auth/google/callback"

# Optional: override the pilot source folder.
TRIPPEDD_DRIVE_FOLDER_ID="1e55zooUU98r9MXyRzcR0qgNq1EqGiqVI"
