{
  "version": 2,
  "selection_policy": {
    "default": "capability_first",
    "never_failover_on_creative_contract_violation": true,
    "preserve_outputs_before_failover": true,
    "max_backend_attempts": 2
  },
  "workers": {
    "2d_motion": ["motion-canvas", "open-motion", "opentoonz", "remotion"],
    "3d_scene": ["blender", "openusd", "gaffer"],
    "generative_media": ["comfyui", "pallaidium", "4brospix", "pantomatrix"],
    "compositing": ["natron", "gaffer", "openfx"],
    "editorial": ["opentimelineio", "mlt", "kdenlive", "olive"],
    "render_farm": ["flamenco", "opencue"],
    "media_transport": ["ffmpeg", "mediainfo", "bento4"],
    "image_pipeline": ["openimageio", "openexr", "opencolorio"],
    "video_processing": ["vapoursynth", "pyscenedetect"],
    "speech_voice": ["whisperx", "piper"],
    "audio_cleanup": ["demucs"],
    "audio_edit_mix": ["ardour", "audacity"],
    "review": ["openrv"]
  },
  "pipelines": {
    "commercial_v4": {
      "scope": ["THE BASTARD", "IN THE BUSHES", "GOD MOLECULE", "TRIPPEDD"],
      "forbidden_scope": ["SMOKE & MIRRORS"],
      "preferred": ["blender", "motion-canvas", "open-motion"],
      "fallback": ["remotion"],
      "required_qc": ["frame_activity", "audio_non_silent", "scope", "resolution", "fps", "duration", "container_integrity"]
    },
    "ep01_story_runner": {
      "preferred": ["blender", "opentimelineio", "ffmpeg"],
      "fallback": ["mlt", "kdenlive"],
      "required_qc": ["source_integrity", "timeline_integrity", "media_integrity"]
    },
    "ep01_autonomous": {
      "preferred": ["blender", "comfyui", "pallaidium", "pantomatrix"],
      "fallback": ["motion-canvas", "open-motion", "remotion"],
      "required_qc": ["chunk_integrity", "frame_activity", "audio_non_silent", "assembly_integrity"]
    }
  }
}
