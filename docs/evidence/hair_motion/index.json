  "set": "hair_motion",
  "label": "EVIDENCE",
  "sourceCommit": "4d0bc8c572402e0f6d1a6c07cd4ac48b3a5c9d65",
  "sourceAsset": {
    "path": "assets/rigs/MARS_FACE.blend",
    "note": "MARS_source.glb NOT touched. The cloth runs on a throwaway HAIR_SIM object carved from a COPY; MARS_MESH's stored geometry is unchanged."
  },
  "control": "Blender native CLOTH on hair-only geometry, pinned by the measured HAIR_PIN gradient",
  "measurements": {
    "peakTipSecondaryMM": 53.59,
    "peakRootTravelMM": 132.09,
    "lagFramesCrossCorrelation": 5,
    "rootTipCorrelation": 0.334,
    "maxHairRootGiveMM": 3.128,
    "maxSkinRigidResidualMM": 0.0,
    "tipVerts": 2825,
    "rootVerts": 1644,
    "frames": 36,
    "yawDeg": 38.0
  },
  "qc": {
    "physical": {
      "verified": true,
      "engine": "BLENDER_EEVEE_NEXT",
      "checks": [
        {
          "check": "the hair actually deforms, not just rides the head",
          "pass": true,
          "detail": "53.59 mm peak at the tips with the head's FULL rigid transform removed by Kabsch"
        },
        {
          "check": "it lags the head",
          "pass": true,
          "detail": "cross-correlation +5 frames, r=0.33 -- decoupled, not carried"
        },
        {
          "check": "HIS SKIN IS NOT IN THE SOLVER",
          "pass": true,
          "detail": "skin rigid residual 0.0000 mm; the face comes straight from the armature"
        },
        {
          "check": "judged as a sequence, two angles",
          "pass": true,
          "detail": "36 frames x FRONT and SIDE"
        },
        {
          "check": "motion is plausible for DREADLOCKS",
          "pass": false,
          "detail": "it is not. By f33-f36 the locks stand out nearly horizontally and have not settled after a 38 deg turn. Dreads are heavy and stiff; this reads as loose hair in wind. bending_stiffness 6 / mass 0.25 / air_damping 1.4 are too soft for these forms"
        },
        {
          "check": "self-collision",
          "pass": false,
          "detail": "OFF this pass. Locks can pass through one another; not obviously visible at this amplitude but it is not physically right"
        }
      ]
    },
    "visual": {
      "verdict": "PENDING",
      "reviewer": "claude",
      "notes": "MECHANISM PASSES, REALISM DOES NOT. The hair genuinely swings and trails the head, and his face stays crisp in every frame -- which is the 0.0000 mm skin residual showing visually, and a direct fix of the earlier pass where his jaw softened. But the amplitude is wrong for dreadlocks: too floppy, still swinging at the end of the take. Stiffness/mass/damping need a tuning pass against real dreadlock footage before this gets a visual PASS.",
      "rule": "VISUAL_FAIL outranks a passing physical gate. PENDING is not PASS."
    },
    "status": "PENDING"
  },
