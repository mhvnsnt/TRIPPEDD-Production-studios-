{
  "schemaVersion": 2,
  "name": "TRIPPEDD Production Studios Open-Source Production Stack",
  "principle": "Every production capability must resolve to a real executable, library, service, project format, generated artifact, or explicit human gate. No fake AVAILABLE state.",
  "required": ["ffmpeg", "ffprobe", "opencv", "pyscenedetect", "whisper", "tesseract", "otio"],
  "optional": ["blender", "mediainfo", "exiftool", "bwfmetaedit", "vmaf", "kdenlive", "mlt", "olive", "shotcut", "audacity", "ardour", "rubberband", "aubio", "opencolorio", "openassetio", "usd", "materialx", "openvdb", "natron", "embree", "flamenco", "opencue", "demucs", "pyblish", "kitsu", "zou", "pytorch", "onnxruntime", "prometheus", "grafana", "opentelemetry"],
  "interchange": {
    "editorial": "OpenTimelineIO",
    "assets": "OpenAssetIO",
    "scene": "OpenUSD",
    "materials": "MaterialX",
    "color": "OpenColorIO",
    "media": "FFmpeg/FFprobe",
    "audio": "BWF/WAV"
  },
  "backends": {
    "deterministicMedia": "ffmpeg",
    "analysis": ["ffprobe", "mediainfo", "opencv", "pyscenedetect", "whisper", "tesseract", "exiftool"],
    "procedural3D": ["blender", "openvdb", "embree"],
    "editorial": ["kdenlive", "olive", "shotcut"],
    "editorialRender": "mlt",
    "compositing": "natron",
    "colorManagement": "opencolorio",
    "assetInterchange": "openassetio",
    "sceneInterchange": "usd",
    "materialInterchange": "materialx",
    "distributedRendering": ["flamenco", "opencue"],
    "audio": ["audacity", "ardour", "rubberband", "aubio", "demucs"],
    "publishing": "pyblish",
    "perceptualQC": "vmaf",
    "productionTracking": ["kitsu", "zou"]
  },
  "episodeCuts": {
    "autonomous": "AUTONOMOUS",
    "storyRunner": "SHOWRUNNER",
    "sharedEvidencePolicy": "Both cuts consume the same physical-source evidence model; editorial interpretation remains separate."
  },
  "policy": {
    "optionalToolsMayBeAbsent": true,
    "absenceMustBeExplicit": true,
    "archivedProjectsMustNotBeBlindlyProvisioned": true,
    "humanEditorialLockRequiredForFinalMaster": true,
    "generatedMaterialMustCarryProvenance": true,
    "physicalSourceTimelineIsAuthoritativeForPhysicalEvents": true,
    "thirdPartySourceIsNotVendoredByDefault": true,
    "heavyBinariesUseReproducibleProvisioning": true,
    "productionPromotionRequiresRealInputEvidence": true
  }
}
