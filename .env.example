# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this studio is hosted.
APP_URL="MY_APP_URL"

# Server-owned Google Drive OAuth. The existing web client ID can be reused;
# the server uses PKCE, so no client secret needs to be copied into the app.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
# If GOOGLE_CLIENT_ID is omitted, VITE_GOOGLE_CLIENT_ID is also accepted.
# GOOGLE_REDIRECT_URI must match the OAuth client's authorized redirect URI.
# If omitted, the server derives ${APP_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI="MY_APP_URL/api/auth/google/callback"

# Optional: override the pilot source folder.
TRIPPEDD_DRIVE_FOLDER_ID="1e55zooUU98r9MXyRzcR0qgNq1EqGiqVI"
