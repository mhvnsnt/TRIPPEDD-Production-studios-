# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this studio is hosted.
APP_URL="MY_APP_URL"

# Server-owned Google Drive OAuth.
# GOOGLE_CLIENT_ID may reuse the existing Google OAuth web client ID.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
# Must exactly match the OAuth client's authorized redirect URI.
# If omitted, the server derives ${APP_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI="MY_APP_URL/api/auth/google/callback"

# Optional: override the pilot source folder.
TRIPPEDD_DRIVE_FOLDER_ID="1e55zooUU98r9MXyRzcR0qgNq1EqGiqVI"
