TRIPPEDD_GITHUB_REPO=TRIPPEDD-Production-studios-
TRIPPEDD_GITHUB_APP_ID=
TRIPPEDD_GITHUB_PRIVATE_KEY_PATH=/etc/trippedd/github-app-private-key.pem
TRIPPEDD_RUNNER_LABEL=trippedd-production
TRIPPEDD_RUNNER_DIR=/opt/trippedd-runner
