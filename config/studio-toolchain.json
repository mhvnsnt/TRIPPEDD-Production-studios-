{
  "schemaVersion": 1,
  "name": "TRIPPEDD Production Studios Open-Source Production Stack",
  "principle": "Every production capability must resolve to a real executable, library, service, project format, or explicit human gate. No fake AVAILABLE state.",
  "required": [
    "ffmpeg",
    "ffprobe",
    "opencv",
    "pyscenedetect",
    "whisper",
    "tesseract",
    "otio"
  ],
  "optional": [
    "blender",
    "kdenlive",
    "mlt",
    "natron",
    "opencolorio",
    "openassetio",
    "opencue",
    "demucs"
  ],
  "interchange": {
    "editorial": "OpenTimelineIO",
    "assets": "OpenAssetIO",
    "color": "OpenColorIO",
    "media": "FFmpeg/FFprobe"
  },
  "backends": {
    "deterministicMedia": "ffmpeg",
    "analysis": ["ffprobe", "opencv", "pyscenedetect", "whisper", "tesseract"],
    "procedural3D": "blender",
    "editorial": "kdenlive",
    "editorialRender": "mlt",
    "compositing": "natron",
    "colorManagement": "opencolorio",
    "assetInterchange": "openassetio",
    "distributedRendering": "opencue"
  },
  "policy": {
    "optionalToolsMayBeAbsent": true,
    "absenceMustBeExplicit": true,
    "archivedProjectsMustNotBeBlindlyProvisioned": true,
    "humanEditorialLockRequiredForFinalMaster": true,
    "generatedMaterialMustCarryProvenance": true,
    "physicalSourceTimelineIsAuthoritativeForPhysicalEvents": true
  }
}
